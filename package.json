{
	"name": "onething",
	"version": "1.1.7",
	"description": "An AI chat desktop app",
	"author": {
		"name": "SongRunqi",
		"email": "yitiansong4@gmail.com"
	},
	"bin": {
		"onething": "./bin/onething.mjs"
	},
	"type": "module",
	"//engines": "地板 22.13 = `node:sqlite` 免 --experimental 标志的第一个版本(检索方案 S5 要在 server 侧用它,不再引第三方原生 sqlite);天花板 <26 = 只承诺已经真跑过的大版本。`.nvmrc` 钉 24 —— Electron 41 内嵌的就是 Node 24.14,开发机与桌面运行时同一个大版本,`.node` 二进制不必两套。",
	"engines": {
		"node": ">=22.13 <26"
	},
	"//workspaces": "逐个列包,绝不写 packages/* 或 apps/* glob(apps/mobile 带 expo + react-native 全套依赖)。且 @onething/* 永不进本文件的 dependencies —— 一进去 electron-vite 的 externalizeDepsPlugin 就会把它们 externalize,而 exports 指向 .ts 源,asar 里没有可执行文件。",
	"workspaces": [
		"packages/core",
		"packages/gateway",
		"packages/onething-runtime",
		"packages/backend",
		"packages/client"
	],
	"scripts": {
		"dev": "node scripts/dev-unified.mjs",
		"dev:electron": "node scripts/dev-unified.mjs electron",
		"dev:web": "node scripts/dev-unified.mjs web",
		"start": "npm run electron:dev",
		"electron:dev": "node apps/desktop-react/scripts/dev-app.mjs",
		"electron:build": "node scripts/build-desktop.mjs",
		"build:cli": "node scripts/build-cli.mjs",
		"//web-shell": "web:dev / web:build 起的是 apps/web(Vue,退役中);web:dev:react / web:build:react 起的是 React 壳的 web 模式(`--mode web` → :5174 + 仓根 dist/web)。运行时统一第四步 4b 删 apps/web 时,react 两条改名接管这两个名字。",
		"web:dev": "vite --config apps/desktop-react/vite.config.ts --mode web",
		"web:build": "vite build --config apps/desktop-react/vite.config.ts --mode web",
		"gate:web-shell": "node scripts/gate-web-shell.mjs",
		"server:build": "node scripts/build-server.mjs",
		"server:start": "node dist/server/main.js",
		"sign:dev:mac": "node scripts/sign-dev-binaries.mjs",
		"typecheck": "npm run typecheck:node && npm run typecheck:desktop",
		"typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
		"typecheck:desktop": "tsc --noEmit -p apps/desktop-react",
		"build": "node scripts/build-desktop.mjs",
		"build:check": "npm run typecheck && bun run build",
		"build:unpack": "npm run build && node scripts/run-electron-builder.mjs --dir",
		"build:win": "npm run build && node scripts/run-electron-builder.mjs --win",
		"build:mac": "npm run build && node scripts/run-electron-builder.mjs --mac",
		"build:linux": "npm run build && node scripts/run-electron-builder.mjs --linux",
		"postinstall": "npm run fix:node-pty-perms",
		"release": "bash scripts/release.sh",
		"lint": "eslint . --fix",
		"boundary": "bun scripts/headless-boundary-check.ts",
		"boundary:gate": "node scripts/boundary-gate.mjs",
		"transport:gate": "node scripts/transport-gate.mjs",
		"gate:native": "node scripts/gate-native-abi.mjs",
		"gate:client": "node scripts/gate-client-runtimes.mjs",
		"gate:packaged": "node scripts/gate-packaged.mjs",
		"gate:store-backup": "node scripts/gate-store-backup.mjs",
		"log:check": "node scripts/log-check.mjs",
		"log:gate": "node scripts/log-gate.mjs",
		"log:tail": "node scripts/log-tail.mjs",
		"log:smoke": "node scripts/log-smoke.mjs",
		"session:check": "node scripts/session-check.mjs",
		"session:gate": "node scripts/session-gate.mjs",
		"assembly:check": "node scripts/assembly-gate.mjs --list",
		"assembly:gate": "node scripts/assembly-gate.mjs",
		"sessions:verify": "bun scripts/session-verify.ts",
		"sessions:events-selfcheck": "bun scripts/session-events-read-selfcheck.ts",
		"sessions:hydration-contract": "bun scripts/session-hydration-contract.ts",
		"sessions:blob-gc": "bun scripts/session-blob-gc.ts",
		"sessions:storage-report": "bun scripts/session-storage-report.ts",
		"migrate:sessions:events": "node scripts/migrate-sessions-events.mjs",
		"sessions:shadow-report": "node scripts/session-shadow-report.mjs",
		"sessions:shadow-reset": "node scripts/session-shadow-reset.mjs",
		"sessions:shadow-overhead": "node scripts/measure-shadow-overhead.mjs",
		"sessions:shadow-battery": "node scripts/shadow-battery.mjs",
		"lint:ci": "eslint . --max-warnings 200",
		"test": "vitest run",
		"test:watch": "vitest",
		"fix:node-pty-perms": "node scripts/fix-node-pty-perms.mjs",
		"evals": "bun evals/run.mjs",
		"evals:diagnose": "bun scripts/diagnose-weekly.mjs",
		"gate:search-index": "node scripts/gate-search-index.mjs",
		"sessions:verify:gate": "node scripts/session-verify-gate.mjs"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "^0.17.1",
		"@ant-design/colors": "^8.0.1",
		"@anthropic-ai/claude-agent-sdk": "^0.3.214",
		"@deepseek-ai/cordis": "4.0.1",
		"@modelcontextprotocol/client": "^2.0.0",
		"@huggingface/transformers": "^3.7.6",
		"@zip.js/zip.js": "^2.8.11",
		"culori": "^4.0.2",
		"diff": "^8.0.2",
		"execa": "^9.6.1",
		"node-pty": "^1.1.0",
		"pinyin-pro": "^3.28.1",
		"sherpa-onnx-node": "^1.13.4",
		"sqlite-vec": "^0.1.7-alpha.2",
		"undici": "^8.1.0",
		"uuid": "^13.0.0",
		"ws": "^8.20.0",
		"yaml": "^2.8.2",
		"zod": "^4.2.0"
	},
	"optionalDependencies": {
		"fsevents": "2.3.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.17.0",
		"@types/diff": "^7.0.2",
		"@types/node": "^22.19.1",
		"@types/uuid": "^11.0.0",
		"electron": "41.1.1",
		"electron-builder": "^26.0.12",
		"eslint": "^9.17.0",
		"globals": "^15.14.0",
		"happy-dom": "^20.9.0",
		"playwright": "^1.61.1",
		"shiki": "^3.20.0",
		"typescript": "^5.1.6",
		"typescript-eslint": "^8.57.2",
		"vite": "^7.2.7",
		"vitest": "^4.0.18"
	},
	"trustedDependencies": [
		"electron"
	],
	"main": "apps/desktop-react/dist-electron/main.cjs"
}
