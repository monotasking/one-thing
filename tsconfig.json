{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@onething/electron-host/*": ["apps/electron/src/*"],
      "@onething/runtime": ["packages/onething-runtime/src/index.ts"],
      "@onething/runtime/*": ["packages/onething-runtime/src/*"],
      "@onething/app/*": ["packages/onething-runtime/src/app/*"],
      "@/*": ["packages/renderer/*"],
      "@main/*": ["apps/electron/src/main/*"],
      "@shared/*": ["packages/shared/*"],
      "@preload/*": ["apps/electron/src/preload/*"]
    },
    "types": ["node"]
  },
  "include": ["packages", "apps"],
  "exclude": ["node_modules", "dist"]
}
