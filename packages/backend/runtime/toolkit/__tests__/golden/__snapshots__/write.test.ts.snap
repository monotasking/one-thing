"Invalid write parameters:
- content: Invalid input: expected string, received undefined"
`;

exports[`golden: write > error: the file changing during approval aborts the write > changed during approval 1`] = `"File changed after permission approval and the resulting write diff changed: <DIR>/note.txt. Please retry the write."`;

