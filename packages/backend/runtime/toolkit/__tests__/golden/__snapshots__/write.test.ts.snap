// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`golden: write > boundary: overwriting an existing file yields the pinned diff counts > effects 1`] = `
[
  {
    "barrier": true,
    "external": false,
    "kind": "file_write",
    "metadata": {
      "additions": 1,
      "created": false,
      "deletions": 2,
      "isExternal": false,
      "originalContentHash": "9f6575f7ff41f0b5d35fe2255b1a9a587e1b855071ed27c324615c6d1f1395ad",
      "path": "<DIR>/note.txt",
    },
    "resources": [
      "<DIR>/*",
    ],
  },
]
`;

exports[`golden: write > boundary: overwriting an existing file yields the pinned diff counts > preview 1`] = `
{
  "additions": 1,
  "deletions": 2,
  "diff": "Index: <DIR>/note.txt
===================================================================
--- <DIR>/note.txt
+++ <DIR>/note.txt
@@ -1,3 +1,2 @@
 one
-two
-three
+two changed
",
  "path": "<DIR>/note.txt",
  "title": "Overwrite note.txt",
}
`;

exports[`golden: write > error: an unwritable target fails in plan > unwritable target 1`] = `"Path is a directory, not a file: <DIR>/blocked"`;

