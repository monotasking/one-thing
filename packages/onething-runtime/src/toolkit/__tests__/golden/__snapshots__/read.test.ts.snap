  "path": "<DIR>/.env",
  "title": "Read sensitive file: .env",
}
`;

exports[`golden: read > permission input: an out-of-sandbox path reports external_directory > effects 1`] = `
[
  {
    "barrier": true,
    "external": true,
    "kind": "external_directory",
    "metadata": {
      "boundary": "<DIR0>",
      "operation": "Read file",
      "path": "<DIR1>/secret.txt",
      "targetType": "file",
    },
    "resources": [
      "<DIR1>/*",
    ],
  },
  {
    "barrier": false,
    "kind": "read",
    "metadata": {
      "path": "<DIR1>/secret.txt",
    },
    "resources": [
      "<DIR1>/secret.txt",
    ],
    "sensitive": false,
  },
]
`;

exports[`golden: read > permission input: an out-of-sandbox path reports external_directory > preview 1`] = `
