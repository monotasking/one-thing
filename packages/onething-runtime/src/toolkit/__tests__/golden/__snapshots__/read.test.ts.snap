exports[`golden: read > permission input: a sensitive file reports sensitive_file_read > effects 1`] = `
[
  {
    "barrier": true,
    "kind": "sensitive_file_read",
    "metadata": {
      "category": "env",
      "path": "<DIR>/.env",
      "reason": "Environment/config secret file",
    },
    "resources": [
      "<DIR>/.env",
    ],
    "sensitive": true,
  },
]
`;

