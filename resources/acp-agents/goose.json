{
  "id": "goose",
  "name": "Goose",
  "vendor": "Block",
  "description": "Block 开源的本地 agent,可接多家模型与 MCP 扩展。",
  "homepage": "https://block.github.io/goose",
  "launch": {
    "command": "goose",
    "args": [
      "acp"
    ]
  },
  "detect": {
    "bins": [
      "goose"
    ],
    "versionArgs": [
      "--version"
    ]
  },
  "install": {
    "hint": "https://block.github.io/goose/docs/getting-started/installation"
  },
  "auth": {
    "hint": "在终端里运行 goose configure 选模型与凭据。"
  },
  "configPaths": [
    "~/.config/goose"
  ],
  "registryId": "goose"
}
