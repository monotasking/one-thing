{
  "name": "warm",
  "label": "暖砂 Warm Sand",
  "lineage": "Organic",
  "mode": "light",
  "mood": "像一张摊在木桌上的暖砂色纸；卡片轻轻浮起，字大而稳，工具在旁边安静地干活。",

  "palette": {
    "bg": "#f4e9d7",
    "bgSunk": "#ebddc5",
    "bgWash": "#efe2cc",
    "surface": "#fffaf2",
    "surfaceAlt": "#fbf2e3",
    "surfaceSunk": "#f7ecd9",
    "border": "#e0cfb2",
    "borderStrong": "#d2bd9a",

    "text": "#3a3129",
    "textSecondary": "#6b5c4c",
    "textMuted": "#94836f",
    "textSubtle": "#9d8c77",

    "accent": "#c67139",
    "accentStrong": "#a95a26",
    "accentSoft": "#f3ddc6",
    "accentInk": "#fffaf2",

    "accent2": "#7a8a5e",
    "accent2Strong": "#5f6d47",
    "accent2Soft": "#e4e9d7",

    "warning": "#b3813a",
    "warningSoft": "#f6e5c6",
    "danger": "#a94b3a",
    "dangerSoft": "#f5dcd4"
  },

  "fonts": {
    "display": "Fraunces, \"Noto Serif SC\", Georgia, serif",
    "body": "Figtree, \"Noto Sans SC\", -apple-system, \"PingFang SC\", sans-serif",
    "mono": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
    "cjkDisplay": "Noto Serif SC",
    "cjkBody": "Noto Sans SC",
    "baseSize": "15.5px",
    "bodyLineHeight": 1.66,
    "displayWeight": 600,
    "scale": ["12.5px", "13.5px", "14.5px", "15.5px", "17px", "19px", "23px", "34px"]
  },

  "density": "moderate",
  "radius": {
    "sm": "10px",
    "md": "14px",
    "lg": "18px",
    "xl": "24px",
    "pill": "999px"
  },
  "layoutStyle": "asymmetric-left",
  "dividers": "soft-fields",
  "buttonStyle": "pill",
  "colorUse": "two-voice",

  "colorRoles": {
    "accent": "你：主行动、你的消息、被选中的东西、焦点环",
    "accent2": "助手：AI 头像与回复脊线、工具卡、已完成状态、新增行数",
    "warning": "进行中 / 待确认",
    "danger": "失败 / 删除行数"
  },

  "shadows": {
    "sm": "0 1px 2px rgba(88,58,26,.06), 0 2px 6px rgba(88,58,26,.05)",
    "md": "0 2px 4px rgba(88,58,26,.06), 0 10px 24px -10px rgba(88,58,26,.16)",
    "lg": "0 3px 8px rgba(88,58,26,.07), 0 20px 44px -16px rgba(88,58,26,.24)"
  },
  "focusRing": "2px solid #c67139, offset 2px"
}
