{
  "extends": "./tsconfig.json",
  "include": [
    "electron.vite.config.*",
    "packages/core/**/*",
    "packages/onething-runtime/**/*",
    "packages/backend/**/*",
    "packages/gateway/**/*",
    "apps/electron/**/*",
    "apps/server/**/*",
    "apps/web/**/*",
    "scripts/gateway-smoke-test.ts",
    "packages/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"]
  }
}
