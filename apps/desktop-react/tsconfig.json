{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    // D0 起 `@renderer/platform` 的源码进了本程序的类型图。`noUnusedLocals` /
    // `noUnusedParameters` 是**程序级**开关,没法只对自己这半边开 —— 开着就会把
    // 仓里其它包的历史未用声明当成本应用的错误报出来。仓根三份 tsconfig 本来
    // 就是关的,这里对齐它们(卫生靠 eslint,不靠这两颗)。
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "types": ["vite/client", "vitest/globals", "node"],
    // alias 与 vite.config.ts 逐条对齐(apps/web 同款做法:指源码目录)。
    // `@onething/*` 没有 paths —— 它们是真 workspace 包,走 exports 解析。
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../../packages/shared/*"],
      "@renderer/*": ["../../packages/renderer/*"],
      "@/*": ["../../packages/renderer/*"]
    }
  },
  // `packages/shared/types` 是**环境声明**目录(culori / *.md?raw 的 shim)。
  // 仓根 tsconfig 靠 `packages/shared/**/*` 顺带收进来;这里 include 只有自己那两棵树,
  // 所以要显式带上,否则跨包源码里的 `import 'culori'` 报 TS7016。
  // `scripts` 里只有一个 .ts(冒烟探针 scripts/smoke/core-boot-probe.ts;其余是 .mjs,
  // 没开 allowJs 就不会被收进来)。它是 main 进程侧的代码,理应和 electron/ 一起过类型。
  "include": ["src", "electron", "scripts", "vite.config.ts", "../../packages/shared/types"]
}
