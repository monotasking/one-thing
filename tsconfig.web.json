{
  "extends": "./tsconfig.json",
  "include": [
    "packages/renderer/**/*",
    "packages/renderer/**/*.vue",
    "packages/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["packages/renderer/*"],
      "@renderer/*": ["packages/renderer/*"],
      "@shared/*": ["packages/shared/*"]
    }
  }
}
